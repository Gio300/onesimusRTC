# Automatic HTTPS via Let's Encrypt. The sslip.io hosts remain available as a
# fallback while the public onesimos.com records propagate.

{
	# Keep HTTPS on TCP so LiveKit can own UDP 443 for TURN on restrictive
	# mobile networks. HTTP/3 would otherwise bind the same UDP port.
	servers :443 {
		protocols h1 h2
	}
}

# The app + token server + web client.
onesimos.com, www.onesimos.com, {$WEB_HOST} {
	encode zstd gzip
	reverse_proxy localhost:8080
}

# LiveKit signaling (wss). Media (UDP 50000-60000 / TCP 7881) goes direct to the
# host public IP, not through Caddy.
lk.onesimos.com, {$LK_HOST} {
	reverse_proxy localhost:7880
}
