# Copy to .env and fill in. NEVER commit the real .env.
# These must match the keys configured in the LiveKit server (infra/livekit.yaml).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_min_32_chars_long
# The wss:// URL the browser uses to reach LiveKit. Locally: ws://localhost:7880
# In AWS deploy this becomes wss://lk.<ip>.sslip.io (set by cloud-init).
LIVEKIT_WS_URL=ws://localhost:7880
# Port this token+web server listens on.
PORT=8080
